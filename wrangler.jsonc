{
  "name": "sato-portfolio",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM_URL": "https://frosty-bonus-da28.cloudflareaccess.com",
    "ACCESS_AUD": "472744ef829b65a52e72784249db18c8181277608cd176f1032faf11cded775d"
  },
  "build": {
    "command": "node cloudflare/build.mjs"
  },
  "assets": {
    "directory": "./_cloudflare",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "STUDY_DB",
      "database_name": "denko-study",
      "database_id": "6c61a5c8-14ec-43f3-9f56-19db00cf44d4"
    }
  ]
}
