{
  "name": "sato-portfolio",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "node cloudflare/build.mjs" },
  "assets": {
    "directory": "./_cloudflare",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "STUDY_DB",
      "database_name": "denko-study",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
